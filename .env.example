# Local stack
POSTGRES_DB=ostrovok
POSTGRES_USER=ostrovok
POSTGRES_PASSWORD=ostrovok
POSTGRES_PORT=5434
BACKEND_PORT=8010
WEB_PORT=5173
# Единственный публичный порт стека: nginx проксирует /v1, /docs и frontend.
NGINX_PORT=8080
LOG_LEVEL=INFO

# Подпись JWT (access + refresh). Пусто — backend генерирует случайный ключ на
# процесс: сессии не переживают рестарт и не общие между воркерами. Для стабильных
# сессий задать значение: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# scripts/init_dev.sh подставляет случайный ключ при создании .env.
AUTH_JWT_SECRET=

# The mock provider is offline and deterministic.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MODEL_PARSE=
LLM_MODEL_QUESTIONS=
LLM_MODEL_FINALISTS=
LLM_MODEL_EXPLAIN=
LLM_MODEL_DIFF=
EMBEDDING_MODEL=qwen3-embedding-8b
EMBEDDING_BASE_URL=https://api.aitunnel.ru/v1
EMBEDDING_API_KEY=
# Optional JSON object of model prices in RUB per million tokens (values are strings).
# Unknown rerank rates intentionally remain unpriced until configured.
MODEL_PRICES_VERSION=user-rates-2026-11-05
MODEL_PRICES_JSON=
RERANK_MODEL=

# Optional adapters
TELEGRAM_BOT_TOKEN=
