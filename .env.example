# PostgreSQL
POSTGRES_DB=ostrovok
POSTGRES_USER=ostrovok
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5434

# Порты, публикуемые на 127.0.0.1 (5432/8000/8001 заняты другим проектом)
BACKEND_PORT=8010
AGENT_PORT=8011
WEB_PORT=5173

# Наблюдение
LOG_LEVEL=INFO

# mock | openai | ... (см. services/agent/app/core/llm.py)
LLM_PROVIDER=mock

# Обязателен только для профиля bot: docker compose --profile bot up
TELEGRAM_BOT_TOKEN=
