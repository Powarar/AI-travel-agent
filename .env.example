# PostgreSQL
POSTGRES_DB=ostrovok
POSTGRES_USER=ostrovok
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5434

# Порты, публикуемые на 127.0.0.1 (5432/8000/8001 заняты другим проектом)
BACKEND_PORT=8010
AGENT_PORT=8011
WEB_PORT=5173

# Наблюдение
LOG_LEVEL=INFO

# aitunnel — живой шлюз: платная модель обрабатывает запросы, поиск по каталогу проекта.
# Маршруты слотов: docs/LLM-BOUNDARY.md. Ключ шлюза AITUNNEL отдельный, выданный только для жюри.
# mock — только для офлайн-прогона, включается вручную: LLM_PROVIDER=mock
LLM_PROVIDER=aitunnel
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_QUESTIONS=
LLM_MODEL_FINALISTS=
LLM_MODEL_EXPLAIN=
RERANK_MODEL=

# agent — ход исполняет оркестратор агента; fixture — заглушка без каталога и LLM
BACKEND_EXECUTOR=agent

# Бот (профиль bot) и проверка подписи Telegram Mini App в backend; токен выдаёт @BotFather
TELEGRAM_BOT_TOKEN=
